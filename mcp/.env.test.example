# SlimMCP Test Environment Variables
# Copy this file to .env.test and fill in your actual credentials
# NEVER commit .env.test to version control

# Notion MCP Server Configuration
# Get your integration token from: https://www.notion.so/my-integrations
# 1. Create a new integration
# 2. Copy the "Internal Integration Token" (starts with secret_ or ntn_)
# 3. Share a test database with your integration
NOTION_TOKEN=secret_your_notion_integration_token_here
NOTION_DATABASE_ID=your_test_database_id_here

# GitHub MCP Server Configuration
# Create a personal access token: https://github.com/settings/tokens
# Required scopes: repo, read:org, read:user
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_REPO_OWNER=your_github_username
GITHUB_REPO_NAME=your_test_repo_name

# MCP Server URLs
# Notion: Use https://mcp.notion.com/mcp or run @notionhq/notion-mcp-server locally
# GitHub: Use localhost bridge (see start-github-mcp.sh)
NOTION_MCP_URL=https://mcp.notion.com/mcp
GITHUB_MCP_URL=http://localhost:3100

# Recording Configuration
# Set to "record" to capture new responses, "replay" to use existing cassettes
VCR_MODE=record

# Test Data IDs (update these with real IDs from your test environment)
TEST_NOTION_PAGE_ID=
TEST_GITHUB_ISSUE_NUMBER=
TEST_GITHUB_PR_NUMBER=
