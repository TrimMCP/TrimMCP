{
  "dashboard": {
    "id": null,
    "uid": "slimmcp-overview",
    "title": "SlimMCP - Token Optimization Dashboard",
    "tags": ["slimmcp", "mcp", "optimization", "tokens"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Token Savings Overview",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "avg(mcp_optimizer_savings_percentage)",
            "refId": "A",
            "legendFormat": "Avg Savings %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 50, "color": "yellow"},
                {"value": 70, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Total Tokens Saved",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 6,
          "y": 0
        },
        "targets": [
          {
            "expr": "sum(increase(mcp_optimizer_tokens_saved_total[1h]))",
            "refId": "A",
            "legendFormat": "Tokens Saved (1h)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "color": {
              "mode": "palette-classic"
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Requests Per Second",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "rate(mcp_optimizer_requests_total[5m])",
            "refId": "A",
            "legendFormat": "RPS"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "decimals": 2
          }
        }
      },
      {
        "id": 4,
        "title": "Success Rate",
        "type": "gauge",
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 18,
          "y": 0
        },
        "targets": [
          {
            "expr": "sum(rate(mcp_optimizer_requests_total{status=\"success\"}[5m])) / sum(rate(mcp_optimizer_requests_total[5m])) * 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 90, "color": "yellow"},
                {"value": 95, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Token Savings Over Time",
        "type": "timeseries",
        "gridPos": {
          "h": 9,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "expr": "mcp_optimizer_savings_percentage",
            "refId": "A",
            "legendFormat": "{{server}} - {{tool}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Tokens Saved by Server",
        "type": "timeseries",
        "gridPos": {
          "h": 9,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "targets": [
          {
            "expr": "sum by (server) (rate(mcp_optimizer_tokens_saved_total[5m]))",
            "refId": "A",
            "legendFormat": "{{server}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 20,
              "stacking": {
                "mode": "normal"
              }
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Request Duration (p95)",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 17
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(mcp_optimizer_request_duration_seconds_bucket[5m]))",
            "refId": "A",
            "legendFormat": "{{server}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth"
            }
          }
        }
      },
      {
        "id": 8,
        "title": "Filtering Overhead (p95)",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 17
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(mcp_optimizer_filtering_duration_seconds_bucket[5m])) * 1000",
            "refId": "A",
            "legendFormat": "{{strategy}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth"
            }
          }
        }
      },
      {
        "id": 9,
        "title": "Requests by Server & Status",
        "type": "piechart",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 0,
          "y": 25
        },
        "targets": [
          {
            "expr": "sum by (server, status) (increase(mcp_optimizer_requests_total[1h]))",
            "refId": "A",
            "legendFormat": "{{server}} - {{status}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        }
      },
      {
        "id": 10,
        "title": "Filtering Accuracy",
        "type": "gauge",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 8,
          "y": 25
        },
        "targets": [
          {
            "expr": "avg(mcp_optimizer_filtering_accuracy) * 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 70, "color": "yellow"},
                {"value": 85, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 11,
        "title": "Cost Savings Estimate",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 16,
          "y": 25
        },
        "targets": [
          {
            "expr": "sum(increase(mcp_optimizer_tokens_saved_total[1h])) * 0.000003",
            "refId": "A",
            "legendFormat": "Estimated $ Saved (1h)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 3,
            "color": {
              "mode": "palette-classic"
            }
          }
        },
        "description": "Estimated cost savings based on Claude Sonnet pricing ($3 per million tokens)"
      }
    ],
    "templating": {
      "list": [
        {
          "name": "server",
          "type": "query",
          "query": "label_values(mcp_optimizer_requests_total, server)",
          "refresh": 1,
          "multi": true,
          "includeAll": true
        }
      ]
    },
    "annotations": {
      "list": []
    }
  },
  "overwrite": true
}
