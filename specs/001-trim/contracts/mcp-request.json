{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://slimmcp.io/schemas/mcp-request.json",
  "title": "MCP Request",
  "description": "JSON-RPC 2.0 request structure for Model Context Protocol with SlimMCP field selection extension",
  "type": "object",
  "required": ["jsonrpc", "method"],
  "properties": {
    "jsonrpc": {
      "type": "string",
      "const": "2.0",
      "description": "JSON-RPC protocol version (must be 2.0)"
    },
    "method": {
      "type": "string",
      "description": "MCP method to invoke",
      "enum": [
        "tools/list",
        "tools/call",
        "resources/list",
        "resources/read",
        "prompts/list",
        "prompts/get"
      ]
    },
    "params": {
      "type": "object",
      "description": "Method-specific parameters",
      "properties": {
        "name": {
          "type": "string",
          "description": "Tool or resource name"
        },
        "arguments": {
          "type": "object",
          "description": "Tool-specific arguments",
          "additionalProperties": true
        }
      }
    },
    "id": {
      "oneOf": [
        {"type": "string"},
        {"type": "number"},
        {"type": "null"}
      ],
      "description": "Request identifier for correlation (required for requests expecting response)"
    },
    "_meta": {
      "type": "object",
      "description": "SlimMCP-specific metadata extension",
      "properties": {
        "fieldSelection": {
          "$ref": "#/definitions/fieldSelection"
        }
      }
    }
  },
  "definitions": {
    "fieldSelection": {
      "type": "object",
      "description": "Field selection specification for response filtering",
      "properties": {
        "include": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Fields to explicitly include (supports dot notation)"
        },
        "exclude": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Fields to explicitly exclude"
        },
        "strategy": {
          "type": "string",
          "enum": ["smart", "minimal", "explicit", "passthrough"],
          "default": "smart",
          "description": "Filtering strategy to apply"
        },
        "keepRelated": {
          "type": "boolean",
          "default": true,
          "description": "Include fields related to requested fields"
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 10,
          "description": "Maximum nesting depth to filter"
        }
      },
      "not": {
        "required": ["include", "exclude"]
      }
    }
  }
}
